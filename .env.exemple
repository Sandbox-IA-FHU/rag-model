# Copier ce fichier en .env et renseigner les valeurs.
# .env n'est jamais commite : il est dans .gitignore.

# Cle d'API du fournisseur de modele.
ANTHROPIC_API_KEY=

# Niveau de journalisation : DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Chemin vers un corpus reel, hors depot. Laisser vide pour utiliser le
# corpus invente de evaluations/jeux/.
CORPUS_PATH=
